{
  "schemaVersion": 1,
  "id": "serialcraft",
  "version": "${version}",
  "name": "SerialCraft",
  "description": "Conecta placas Arduino y ESP con Minecraft mediante comunicación serial o Wi-Fi.",
  "authors": [
    "Leonardo Aliaga"
  ],
  "contact": {
    "homepage": "https://github.com/LeonardoAliaga/serialcraft",
    "sources": "https://github.com/LeonardoAliaga/serialcraft",
    "issues": "https://github.com/LeonardoAliaga/serialcraft/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/serialcraft/textures/block/arduino_redstone_block.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.serialcraft.SerialCraft"
    ],
    "client": [
      "com.serialcraft.SerialCraftClient"
    ],
    "fabric-datagen": [
      "com.serialcraft.SerialCraftDataGenerator"
    ]
  },
  "depends": {
    "fabricloader": ">=0.17.3",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "computercraft": "*"
  }
}
